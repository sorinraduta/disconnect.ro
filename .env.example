# Contact form delivery (https://resend.com). Without a key the form still validates
# and filters spam, but asks visitors to write to the email from src/config/site.ts.
RESEND_API_KEY=

# Where contact form messages are delivered. Defaults to site.email.
CONTACT_TO_EMAIL=

# Sender address; its domain must be verified in Resend. Defaults to "Disconnect <noreply@disconnect.ro>".
CONTACT_FROM_EMAIL=

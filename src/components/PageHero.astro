---
interface Props {
    eyebrow: string;
    title: string;
    lead?: string;
    class?: string;
}

const { eyebrow, title, lead, class: className } = Astro.props;
---

<section class:list={["relative overflow-hidden", className]}>
    <div class="grid-bg pointer-events-none absolute inset-0 -z-10 opacity-70" aria-hidden="true"></div>
    <div class="container-x grid items-end gap-10 pt-12 pb-14 md:pt-20 md:pb-20 lg:grid-cols-[1.4fr_1fr]">
        <div class="flex flex-col gap-6">
            <p class="eyebrow">{eyebrow}</p>
            <h1 class="display text-[2.75rem] xs:text-5xl sm:text-6xl lg:text-7xl xl:text-8xl">
                <Fragment set:html={title} />
            </h1>
            {lead && <p class="max-w-xl text-lg text-muted sm:text-xl">{lead}</p>}
            <slot name="actions" />
        </div>
        <slot />
    </div>
</section>

---
/**
 * Cookie consent popup. Two optional categories (analytics, marketing) that map onto
 * Google Consent Mode v2; the strictly necessary one is always on. Reopened from the
 * "Cookie settings" link in the footer. Only rendered when PUBLIC_GTM_ID is set.
 */
import { path, type Locale } from "~/config/routes";
import { useTranslations } from "~/i18n/ui";
import Icon from "./Icon.astro";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = [
    { key: "necessary", locked: true, ...t.cookies.necessary },
    { key: "analytics", locked: false, ...t.cookies.analytics },
    { key: "marketing", locked: false, ...t.cookies.marketing },
];
---

<div
    id="cookie-consent"
    class="fixed inset-x-3 bottom-3 z-50 sm:inset-x-auto sm:bottom-6 sm:left-6 sm:w-[26rem]"
    role="dialog"
    aria-labelledby="cookie-consent-title"
    aria-describedby="cookie-consent-text"
    hidden
>
    <form class="card consent-body relative overflow-hidden p-5 shadow-2xl shadow-black/20 sm:p-6" data-consent-form>
        <div class="pointer-events-none absolute -top-20 -right-20 size-48 rounded-full bg-accent/25 blur-3xl" aria-hidden="true"></div>

        <div class="relative flex items-start justify-between gap-4">
            <p class="eyebrow pt-2.5">{t.cookies.eyebrow}</p>
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent text-accent-ink">
                <Icon name="Cookie" size={20} />
            </span>
        </div>

        <h2 id="cookie-consent-title" class="relative mt-3 text-xl font-semibold tracking-tight text-balance sm:text-2xl">
            {t.cookies.title}
        </h2>
        <p id="cookie-consent-text" class="relative mt-2 text-sm text-muted">
            {t.cookies.text}{" "}
            <a href={path("privacy", lang)} class="link-underline text-fg">{t.cookies.more}</a>
        </p>

        <details class="group relative mt-3">
            <summary
                class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 text-sm font-medium transition-colors hover:text-accent-text [&::-webkit-details-marker]:hidden"
            >
                {t.cookies.customize}
                <Icon name="ChevronDown" size={16} class="transition-transform group-open:rotate-180" />
            </summary>
            <ul class="divide-y divide-line rounded-xl border border-line bg-bg">
                {
                    categories.map((category) => (
                        <li class="flex items-center justify-between gap-4 p-3">
                            <label for={`consent-${category.key}`} class="flex flex-col gap-0.5">
                                <span class="text-sm font-medium">
                                    {category.label}
                                    {category.locked && <span class="ml-1.5 font-mono text-[0.65rem] tracking-wider text-muted uppercase">{t.cookies.always}</span>}
                                </span>
                                <span class="text-xs text-muted">{category.hint}</span>
                            </label>
                            <input
                                type="checkbox"
                                role="switch"
                                id={`consent-${category.key}`}
                                name={category.key}
                                class="switch"
                                checked={category.locked}
                                disabled={category.locked}
                            />
                        </li>
                    ))
                }
            </ul>
        </details>

        <div class="relative mt-4 grid grid-cols-2 gap-2">
            <button type="button" class="btn btn-primary min-h-11 py-2" data-consent="all">{t.cookies.acceptAll}</button>
            <button type="button" class="btn btn-ghost min-h-11 py-2" data-consent="necessary">{t.cookies.rejectAll}</button>
            <button type="submit" class="btn btn-ghost consent-save col-span-2 min-h-11 py-2">{t.cookies.save}</button>
        </div>
    </form>
</div>

<style>
    #cookie-consent:not([hidden]) {
        animation: consent-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    @keyframes consent-in {
        from {
            opacity: 0;
            transform: translateY(1rem) scale(0.98);
        }
    }

    .consent-save {
        display: none;
    }

    .consent-body:has(details[open]) .consent-save {
        display: inline-flex;
    }

    .switch {
        appearance: none;
        position: relative;
        flex-shrink: 0;
        width: 2.75rem;
        height: 1.625rem;
        margin: 0;
        border-radius: 999px;
        background: var(--line);
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .switch::before {
        content: "";
        position: absolute;
        top: 0.1875rem;
        left: 0.1875rem;
        width: 1.25rem;
        height: 1.25rem;
        border-radius: 999px;
        background: var(--fg);
        transition:
            transform 0.2s ease,
            background-color 0.2s ease;
    }

    .switch:checked {
        background: var(--accent);
    }

    .switch:checked::before {
        transform: translateX(1.125rem);
        background: var(--accent-ink);
    }

    .switch:disabled {
        cursor: default;
        opacity: 0.55;
    }
</style>

<script>
    import { applyConsent, readConsent, type Consent } from "~/lib/consent";

    const root = document.querySelector<HTMLElement>("#cookie-consent");

    if (root) {
        const form = root.querySelector<HTMLFormElement>("[data-consent-form]")!;
        const details = root.querySelector<HTMLDetailsElement>("details")!;
        const analytics = form.elements.namedItem("analytics") as HTMLInputElement;
        const marketing = form.elements.namedItem("marketing") as HTMLInputElement;
        let opener: HTMLElement | null = null;

        const show = (from?: HTMLElement) => {
            const current = readConsent();
            analytics.checked = current?.analytics ?? false;
            marketing.checked = current?.marketing ?? false;
            // From the footer link, open straight onto the switches.
            details.open = Boolean(from);
            root.hidden = false;
            opener = from ?? null;
            if (from) analytics.focus();
        };

        const close = () => {
            root.hidden = true;
            opener?.focus();
            opener = null;
        };

        const choose = (consent: Consent) => {
            applyConsent(consent);
            close();
        };

        if (!readConsent()) show();

        form.addEventListener("submit", (event) => {
            event.preventDefault();
            choose({ analytics: analytics.checked, marketing: marketing.checked });
        });

        root.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((button) => {
            button.addEventListener("click", () => {
                const all = button.dataset.consent === "all";
                choose({ analytics: all, marketing: all });
            });
        });

        // Escape only dismisses when a choice already exists; first-time visitors must pick.
        root.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && readConsent()) close();
        });

        document.querySelectorAll<HTMLElement>("[data-cookie-settings]").forEach((button) => {
            button.addEventListener("click", () => show(button));
        });
    }
</script>

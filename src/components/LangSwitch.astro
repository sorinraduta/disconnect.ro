---
import { otherLocale, path, type Alternates, type Locale } from "~/config/routes";
import { useTranslations } from "~/i18n/ui";

interface Props {
    lang: Locale;
    alternates: Partial<Alternates>;
    class?: string;
}

const { lang, alternates, class: className } = Astro.props;
const target = otherLocale(lang);
const t = useTranslations(lang);
const href = alternates[target] ?? path("home", target);
---

<a
    href={href}
    hreflang={target}
    lang={target}
    class:list={[
        "inline-flex h-11 min-w-11 items-center justify-center rounded-full border border-line px-3 font-mono text-sm font-medium transition-colors hover:border-fg",
        className,
    ]}
    data-astro-prefetch="false"
>
    {t.lang.short}<span class="sr-only">, {t.lang.switchTo}</span>
</a>

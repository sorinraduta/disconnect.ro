---
import { absoluteUrl, locales, type Alternates, type Locale } from "~/config/routes";
import { seo } from "~/config/seo";
import { site } from "~/config/site";

interface Props {
    lang: Locale;
    title: string;
    description: string;
    /** Path of this page in every locale it exists in. */
    alternates: Partial<Alternates>;
    image: string;
    imageAlt: string;
    type?: "website" | "article";
    noindex?: boolean;
    graph: Record<string, unknown>[];
    article?: { published: Date; updated?: Date; tags: string[] };
}

const { lang, title, description, alternates, image, imageAlt, type = "website", noindex, graph, article } =
    Astro.props;

const url = (pathname: string) => absoluteUrl(pathname, site.url);
const canonical = alternates[lang] ? url(alternates[lang]) : undefined;
const hreflangs = locales.filter((locale) => alternates[locale]);
const xDefault = alternates.ro ?? alternates.en;
const imageUrl = url(image);
const keywords = seo.keywords[lang].join(", ");

// Escape "<" so content can never close the script tag early.
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
{canonical && <link rel="canonical" href={canonical} />}
<meta
    name="robots"
    content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>

{hreflangs.map((locale) => <link rel="alternate" hreflang={locale} href={url(alternates[locale]!)} />)}
{hreflangs.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={url(xDefault)} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={seo.ogLocale[lang]} />
{
    hreflangs
        .filter((locale) => locale !== lang)
        .map((locale) => <meta property="og:locale:alternate" content={seo.ogLocale[locale]} />)
}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{
    article && (
        <>
            <meta property="article:published_time" content={article.published.toISOString()} />
            <meta property="article:modified_time" content={(article.updated ?? article.published).toISOString()} />
            {article.tags.map((tag) => (
                <meta property="article:tag" content={tag} />
            ))}
        </>
    )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={jsonLd} />

---
import * as icons from "lucide-static";

export type IconName = Exclude<keyof typeof icons, "default">;

interface Props {
    name: IconName;
    class?: string;
    size?: number;
    strokeWidth?: number;
}

const { name, class: className = "", size = 24, strokeWidth = 1.75 } = Astro.props;

// Lucide SVGs are inlined at build time; no icon code ships to the browser.
const svg = String(icons[name])
    .replace(/class="[^"]*"/, `class="${className}"`)
    .replace(/width="24"/, `width="${size}"`)
    .replace(/height="24"/, `height="${size}"`)
    .replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`)
    .replace("<svg", '<svg aria-hidden="true" focusable="false"');
---

<Fragment set:html={svg} />

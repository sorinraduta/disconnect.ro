---
interface Props {
    eyebrow?: string;
    title: string;
    lead?: string;
    id?: string;
    align?: "left" | "center";
    class?: string;
}

const { eyebrow, title, lead, id, align = "left", class: className } = Astro.props;
---

<div class:list={["flex flex-col gap-4", align === "center" && "items-center text-center", className]}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id} class="display max-w-3xl text-4xl sm:text-5xl lg:text-6xl">{title}</h2>
    {lead && <p class="max-w-2xl text-lg text-muted">{lead}</p>}
    <slot />
</div>

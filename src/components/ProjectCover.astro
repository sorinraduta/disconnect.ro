---
import type { Locale } from "~/config/routes";
import type { Project } from "~/lib/content";
import { kaeliImages, studioTeiImages } from "./portfolio/assets";
import { HorahCover } from "./portfolio/horah/HorahCover";
import { KaeliCover } from "./portfolio/kaeli/Kaeli";
import { StudioTeiCover } from "./portfolio/studio-tei-29/StudioTei";

interface Props {
    project: Project;
    lang: Locale;
    class?: string;
    /** Above the fold: load the cover's photo first. */
    priority?: boolean;
}

const { project, lang, class: className, priority = false } = Astro.props;
const { name, colors } = project.data;

/*
 * Projects with their own visual (src/components/portfolio/) draw it from the project's material;
 * the rest get a browser mockup generated from `colors`.
 */
const frame = ["relative aspect-[4/3] overflow-hidden rounded-2xl", className].filter(Boolean).join(" ");
const tei = project.id === "studio-tei-29" ? await studioTeiImages() : undefined;
const kaeli = project.id === "kaeli" ? await kaeliImages(lang) : undefined;
---

{
    project.id === "horah" ? (
        <HorahCover className={frame} />
    ) : tei ? (
        <StudioTeiCover lang={lang} images={tei} priority={priority} className={frame} />
    ) : kaeli ? (
        <KaeliCover lang={lang} images={kaeli} priority={priority} className={frame} />
    ) : (
        <div class={frame} style={`background:${colors.bg};color:${colors.fg}`} aria-hidden="true">
            <div
                class="absolute -right-[12%] -bottom-[18%] size-[70%] rounded-full opacity-90"
                style={`background:${colors.accent}`}
            />
            <div
                class="absolute inset-x-[7%] top-[12%] bottom-0 flex flex-col overflow-hidden rounded-t-xl shadow-2xl shadow-black/30"
                style={`background:${colors.bg};outline:1px solid color-mix(in oklab, ${colors.fg} 18%, transparent)`}
            >
                <div class="flex items-center gap-1.5 px-3 py-2.5" style={`border-bottom:1px solid color-mix(in oklab, ${colors.fg} 15%, transparent)`}>
                    <span class="size-2 rounded-full bg-current opacity-40" />
                    <span class="size-2 rounded-full bg-current opacity-40" />
                    <span class="size-2 rounded-full bg-current opacity-40" />
                </div>
                <div class="flex flex-1 flex-col gap-3 p-[6%]">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-bold tracking-tight">{name}</span>
                        <span class="flex gap-1.5">
                            <span class="h-1.5 w-6 rounded-full bg-current opacity-30" />
                            <span class="h-1.5 w-6 rounded-full bg-current opacity-30" />
                            <span class="h-1.5 w-6 rounded-full bg-current opacity-30" />
                        </span>
                    </div>
                    <div class="mt-[4%] flex flex-col gap-2">
                        <span class="h-3 w-[80%] rounded-full bg-current opacity-90" />
                        <span class="h-3 w-[55%] rounded-full bg-current opacity-90" />
                        <span class="mt-1 h-1.5 w-[65%] rounded-full bg-current opacity-35" />
                        <span class="h-1.5 w-[50%] rounded-full bg-current opacity-35" />
                    </div>
                    <span class="mt-[2%] h-6 w-24 rounded-full" style={`background:${colors.accent}`} />
                    <div class="mt-auto grid grid-cols-3 gap-2">
                        <span class="aspect-square rounded-lg bg-current opacity-10" />
                        <span class="aspect-square rounded-lg opacity-60" style={`background:${colors.accent}`} />
                        <span class="aspect-square rounded-lg bg-current opacity-10" />
                    </div>
                </div>
            </div>
        </div>
    )
}

---
import CtaBand from "~/components/CtaBand.astro";
import FaqList from "~/components/FaqList.astro";
import Icon from "~/components/Icon.astro";
import PageHero from "~/components/PageHero.astro";
import { alternatesFor, path, type Locale } from "~/config/routes";
import { formatTitle, pageMeta } from "~/config/seo";
import { site } from "~/config/site";
import { faq } from "~/data/faq";
import { useTranslations } from "~/i18n/ui";
import Base from "~/layouts/Base.astro";
import { faqPage } from "~/lib/schema";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const meta = pageMeta("faq", lang);
const pathname = path("faq", lang);
const items = faq[lang];

const copy = {
    ro: {
        eyebrow: "Întrebări frecvente",
        title: 'Întrebări scurte. <span class="text-accent-text">Răspunsuri directe.</span>',
        lead: "Tot ce vrei să știi înainte să lucrăm împreună. Dacă nu găsești răspunsul, scrie-ne.",
        ask: "Ai altă întrebare?",
        askText: "Răspundem în maximum o zi lucrătoare.",
    },
    en: {
        eyebrow: "FAQ",
        title: 'Short questions. <span class="text-accent-text">Straight answers.</span>',
        lead: "Everything you want to know before we work together. Can't find your answer? Write to us.",
        ask: "Got another question?",
        askText: "We reply within one business day.",
    },
}[lang];
---

<Base
    lang={lang}
    title={formatTitle(meta)}
    description={meta.description}
    alternates={alternatesFor("faq")}
    image={`/og/${lang}/faq.png`}
    crumbs={[
        { name: t.nav.home, href: path("home", lang) },
        { name: t.nav.faq, href: pathname },
    ]}
    schema={[faqPage(pathname, items)]}
>
    <PageHero eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />

    <section class="container-x grid gap-10 pb-10 lg:grid-cols-[1.6fr_1fr]">
        <FaqList items={items} headingLevel="h2" />
        <aside class="card flex flex-col gap-4 self-start p-7 lg:sticky lg:top-24">
            <span class="grid size-12 place-items-center rounded-2xl bg-accent text-accent-ink">
                <Icon name="MessageCircleQuestion" size={24} />
            </span>
            <h2 class="text-2xl font-bold tracking-tight">{copy.ask}</h2>
            <p class="text-muted">{copy.askText}</p>
            <a href={path("contact", lang)} class="btn btn-primary">
                {t.cta.talk}
                <Icon name="ArrowRight" size={18} />
            </a>
            <a href={`mailto:${site.email}`} class="link-underline self-start font-medium">{site.email}</a>
        </aside>
    </section>

    <CtaBand lang={lang} />
</Base>

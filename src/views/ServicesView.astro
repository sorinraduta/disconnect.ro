---
import CtaBand from "~/components/CtaBand.astro";
import Icon from "~/components/Icon.astro";
import PageHero from "~/components/PageHero.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import { alternatesFor, path, type Locale } from "~/config/routes";
import { formatTitle, pageMeta } from "~/config/seo";
import { services, steps, websiteFeatures } from "~/data/services";
import { useTranslations } from "~/i18n/ui";
import Base from "~/layouts/Base.astro";
import { serviceCatalog } from "~/lib/schema";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const meta = pageMeta("services", lang);
const pathname = path("services", lang);
const [web, design, seo, marketing] = services;

const copy = {
    ro: {
        eyebrow: "Servicii",
        title: 'Un singur loc pentru <span class="text-accent-text">tot ce ține de digital.</span>',
        lead: "Fără cinci furnizori și zeci de email-uri. O echipă care se ocupă de tot, de la logo la campanii.",
        jump: "Sari la",
        webTitle: "Website-uri care lucrează pentru tine",
        webLead: "Fiecare site vine complet echipat. Tu primești cheile, noi ne ocupăm de restul.",
        seoCards: [
            { label: "SEO", where: "Google și Bing", text: "Structură, viteză și cuvinte cheie, ca să urci în rezultate." },
            { label: "AEO", where: "Răspunsuri directe", text: "Întrebări și răspunsuri clare, ca să fii fragmentul recomandat." },
            { label: "GEO", where: "ChatGPT, Gemini, Perplexity", text: "Conținut clar și consecvent, ca AI-ul să te recomande." },
        ],
        marketingList: [
            "Strategie de marketing pe 3–12 luni",
            "Campanii Google Ads, Meta Ads și TikTok Ads",
            "Setup și optimizare Google Business Profile",
            "Landing page-uri și optimizare conversii",
            "Tracking corect: Analytics, Meta Pixel, TikTok Pixel",
            "Rapoarte lunare, pe înțelesul tuturor",
        ],
        designList: ["Logo și variante", "Paletă de culori și tipografie", "Ghid de brand", "Materiale pentru social media", "UI/UX pentru site-uri și aplicații", "Prototipuri interactive"],
        process: "Cum lucrăm",
    },
    en: {
        eyebrow: "Services",
        title: 'One place for <span class="text-accent-text">everything digital.</span>',
        lead: "No five vendors and dozens of emails. One team that handles everything, from logo to campaigns.",
        jump: "Jump to",
        webTitle: "Websites that work for you",
        webLead: "Every site comes fully equipped. You get the keys, we take care of the rest.",
        seoCards: [
            { label: "SEO", where: "Google and Bing", text: "Structure, speed and keywords, so you climb the rankings." },
            { label: "AEO", where: "Direct answers", text: "Clear questions and answers, so you become the featured snippet." },
            { label: "GEO", where: "ChatGPT, Gemini, Perplexity", text: "Clear, consistent content, so AI recommends you." },
        ],
        marketingList: [
            "3–12 month marketing strategy",
            "Google Ads, Meta Ads and TikTok Ads campaigns",
            "Google Business Profile setup and optimisation",
            "Landing pages and conversion optimisation",
            "Accurate tracking: Analytics, Meta Pixel, TikTok Pixel",
            "Monthly reports in plain language",
        ],
        designList: ["Logo and variations", "Colour palette and typography", "Brand guidelines", "Social media assets", "UI/UX for websites and apps", "Interactive prototypes"],
        process: "How we work",
    },
}[lang];

const schema = [
    serviceCatalog(
        lang,
        pathname,
        services.map((service) => ({
            name: service.title[lang],
            description: service.description[lang],
            items: service.items.map((item) => item.label[lang]),
        })),
    ),
];
---

<Base
    lang={lang}
    title={formatTitle(meta)}
    description={meta.description}
    alternates={alternatesFor("services")}
    image={`/og/${lang}/services.png`}
    crumbs={[
        { name: t.nav.home, href: path("home", lang) },
        { name: t.nav.services, href: pathname },
    ]}
    schema={schema}
>
    <PageHero eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead}>
        <nav aria-label={copy.jump} class="flex flex-wrap gap-2 lg:justify-end">
            {
                services.map((service) => (
                    <a href={`#${service.id}`} class="chip min-h-11 bg-card px-4 font-medium hover:border-fg">
                        <Icon name={service.icon} size={16} />
                        {service.title[lang]}
                    </a>
                ))
            }
        </nav>
    </PageHero>

    <!-- Web -->
    <section id={web.id} class="scroll-mt-20 border-t border-line py-20 md:py-28" aria-labelledby="web-title">
        <div class="container-x">
            <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-end">
                <SectionHeading id="web-title" eyebrow={web.title[lang]} title={copy.webTitle} />
                <p class="text-lg text-muted lg:pb-2">{copy.webLead}</p>
            </div>
            <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {
                    websiteFeatures.map((group) => (
                        <div class="card reveal flex flex-col gap-5 p-7">
                            <div class="flex items-center gap-3">
                                <span class="grid size-11 place-items-center rounded-xl bg-accent text-accent-ink">
                                    <Icon name={group.icon} size={22} />
                                </span>
                                <h3 class="text-xl font-bold">{group.title[lang]}</h3>
                            </div>
                            <ul class="flex flex-col gap-3">
                                {group.features.map((feature) => (
                                    <li class="flex items-start gap-3">
                                        <Icon name={feature.icon} size={18} class="mt-0.5 shrink-0 text-accent-text" />
                                        <span>{feature.label[lang]}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Design -->
    <section id={design.id} class="scroll-mt-20 bg-bg-soft py-20 md:py-28" aria-labelledby="design-title">
        <div class="container-x grid gap-12 lg:grid-cols-2 lg:items-center">
            <div class="flex flex-col gap-6">
                <SectionHeading
                    id="design-title"
                    eyebrow={design.title[lang]}
                    title={design.short[lang]}
                    lead={design.description[lang]}
                />
                <ul class="grid gap-3 sm:grid-cols-2">
                    {
                        copy.designList.map((item) => (
                            <li class="flex items-center gap-3 font-medium">
                                <Icon name="Check" size={18} class="text-accent-text" strokeWidth={2.5} />
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </div>
            <!-- Brand board visual -->
            <div class="reveal grid grid-cols-6 grid-rows-[repeat(4,4.5rem)] gap-3 sm:grid-rows-[repeat(4,6rem)]" aria-hidden="true">
                <div class="col-span-3 row-span-2 grid place-items-center rounded-3xl bg-ink">
                    <svg viewBox="0 0 64 64" class="size-20 sm:size-28">
                        <path d="M30 16a18 18 0 0 0 0 36z" fill="#c6f432"></path>
                        <path d="M34 12a18 18 0 0 1 0 36z" fill="#f2f2ec"></path>
                    </svg>
                </div>
                <div class="col-span-3 flex items-end rounded-3xl bg-lime p-4 font-mono text-xs font-semibold text-ink">
                    #C6F432
                </div>
                <div class="col-span-2 flex items-end rounded-3xl bg-fg p-4 font-mono text-xs font-semibold text-bg">
                    #0E0F0D
                </div>
                <div class="flex items-end rounded-3xl border border-line bg-card"></div>
                <div class="col-span-2 row-span-2 flex flex-col justify-between rounded-3xl border border-line bg-card p-5">
                    <span class="text-6xl leading-none font-bold tracking-tighter sm:text-7xl">Aa</span>
                    <span class="font-mono text-xs text-muted">Bricolage Grotesque</span>
                </div>
                <div class="col-span-4 row-span-2 flex flex-col justify-center gap-3 rounded-3xl border border-line bg-card p-5">
                    <span class="h-3 w-2/3 rounded-full bg-fg"></span>
                    <span class="h-2 w-1/2 rounded-full bg-muted/50"></span>
                    <span class="mt-2 h-9 w-32 rounded-full bg-accent"></span>
                </div>
            </div>
        </div>
    </section>

    <!-- SEO / AEO / GEO -->
    <section id={seo.id} class="scroll-mt-20 py-20 md:py-28" aria-labelledby="seo-title">
        <div class="container-x">
            <SectionHeading id="seo-title" eyebrow={seo.title[lang]} title={seo.short[lang]} lead={seo.description[lang]} />
            <ol class="mt-12 grid gap-4 md:grid-cols-3">
                {
                    copy.seoCards.map((card, index) => (
                        <li class="card reveal flex flex-col gap-4 p-7 md:p-9">
                            <span class="font-mono text-sm text-muted">0{index + 1}</span>
                            <h3 class="text-5xl font-extrabold tracking-tight md:text-6xl">{card.label}</h3>
                            <p class="chip self-start font-medium">{card.where}</p>
                            <p class="text-muted">{card.text}</p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <!-- Marketing -->
    <section id={marketing.id} class="scroll-mt-20 border-y border-white/10 bg-ink py-20 text-[#f2f2ec] md:py-28" aria-labelledby="marketing-title">
        <div class="container-x grid gap-12 lg:grid-cols-2">
            <div class="flex flex-col gap-4">
                <p class="eyebrow text-[#a2a69c]">{marketing.title[lang]}</p>
                <h2 id="marketing-title" class="display text-4xl sm:text-5xl lg:text-6xl">{marketing.short[lang]}</h2>
                <p class="max-w-xl text-lg text-[#c9ccc3]">{marketing.description[lang]}</p>
            </div>
            <ul class="flex flex-col divide-y divide-white/10 border-y border-white/10">
                {
                    copy.marketingList.map((item) => (
                        <li class="flex items-center gap-4 py-4 text-lg font-medium">
                            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-lime text-ink">
                                <Icon name="ArrowUpRight" size={16} strokeWidth={2.25} />
                            </span>
                            {item}
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- Process -->
    <section class="container-x py-20 md:py-28" aria-labelledby="process-title">
        <SectionHeading id="process-title" eyebrow={copy.process} title={lang === "ro" ? "De la prima cafea la primii clienți." : "From first coffee to first customers."} />
        <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
                steps.map((step, index) => (
                    <li class="reveal flex flex-col gap-4 border-t-2 border-fg pt-6">
                        <span class="font-mono text-sm text-muted">0{index + 1}</span>
                        <h3 class="flex items-center gap-3 text-2xl font-bold">
                            <Icon name={step.icon} size={24} class="text-accent-text" />
                            {step.title[lang]}
                        </h3>
                        <p class="text-muted">{step.text[lang]}</p>
                    </li>
                ))
            }
        </ol>
    </section>

    <CtaBand lang={lang} />
</Base>

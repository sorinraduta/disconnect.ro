---
import Icon from "~/components/Icon.astro";
import { alternatesFor, path, type Locale } from "~/config/routes";
import { formatTitle, pageMeta } from "~/config/seo";
import { useTranslations } from "~/i18n/ui";
import Base from "~/layouts/Base.astro";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const meta = pageMeta("contactThanks", lang);

const copy = {
    ro: {
        title: 'Mesaj primit. <span class="text-accent-text">Vorbim curând.</span>',
        lead: "Îți răspundem în maximum o zi lucrătoare. Până atunci, aruncă o privire prin portofoliu sau pe blog.",
    },
    en: {
        title: 'Message received. <span class="text-accent-text">Talk soon.</span>',
        lead: "We'll reply within one business day. In the meantime, have a look at our portfolio or blog.",
    },
}[lang];
---

<Base lang={lang} title={formatTitle(meta)} description={meta.description} alternates={alternatesFor("contactThanks")} noindex>
    <section class="container-x flex min-h-[70vh] flex-col items-start justify-center gap-8 py-20">
        <span class="grid size-20 place-items-center rounded-full bg-accent text-accent-ink">
            <Icon name="Check" size={40} strokeWidth={2.5} />
        </span>
        <h1 class="display max-w-4xl text-5xl sm:text-6xl lg:text-7xl" set:html={copy.title} />
        <p class="max-w-xl text-lg text-muted">{copy.lead}</p>
        <div class="flex flex-col gap-3 sm:flex-row">
            <a href={path("portfolio", lang)} class="btn btn-primary">{t.nav.portfolio}<Icon name="ArrowRight" size={18} /></a>
            <a href={path("blog", lang)} class="btn btn-ghost">{t.nav.blog}</a>
        </div>
    </section>
</Base>
